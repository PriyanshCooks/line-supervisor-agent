# LLM: ollama (default) | anthropic | openai
LLM_PROVIDER=ollama
LLM_MODEL=qwen3.5:4b
OLLAMA_HOST=http://localhost:11434
# Set on the machine running the Ollama *server* (not read by this app). Only needed if the sole GPU is integrated:
# OLLAMA_IGPU_ENABLE=1
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# Optional tracing
LANGFUSE_ENABLED=0
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
